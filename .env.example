# =============================================================================
# gh-migration-tool Environment Configuration
# Copy this file to .env and fill in the required values for your Migration Wave.
# =============================================================================

# -----------------------------------------------------------------------------
# 1. Origin SCM Credentials (Required by gh-repo-sync & SourceDriftPostCheck)
# -----------------------------------------------------------------------------
# Personal Access Token or HTTP token with read access to origin repositories
ORIGIN_TOKEN=your_origin_scm_token_here
# Optional username for HTTP Basic Auth (required for Bitbucket / Azure DevOps; defaults to x-access-token)
ORIGIN_USERNAME=

# -----------------------------------------------------------------------------
# 2. Target GitHub App Credentials (Required by GitHub Setup, Migration & Actions Post-check)
# -----------------------------------------------------------------------------
# Numeric GitHub App ID
GITHUB_APP_ID=123456
# Installation ID of the GitHub App on the target organization
GITHUB_APP_INSTALLATION_ID=98765432
# Provide EITHER the PEM private key inline (useful in CI secrets) OR a local file path
GITHUB_APP_PRIVATE_KEY=
GITHUB_APP_PRIVATE_KEY_PATH=/path/to/github-app-private-key.pem
# GitHub REST API base URL (override for GitHub Enterprise Server, e.g. https://github.example.com/api/v3)
GITHUB_API_URL=https://api.github.com

# -----------------------------------------------------------------------------
# 3. Google Sheets Inventory (Required by Stage 6: Inventory Update)
# -----------------------------------------------------------------------------
# Target Google Spreadsheet ID (from https://docs.google.com/spreadsheets/d/<SPREADSHEET_ID>/edit)
GOOGLE_SPREADSHEET_ID=your_google_spreadsheet_id_here
# Path to Google Service Account JSON key file (must have Editor access to the spreadsheet)
# If omitted, gh-migration-inventory-manager falls back to Google Application Default Credentials
GOOGLE_CREDENTIALS_PATH=/path/to/google-service-account.json
# Lifecycle status written to the inventory for verified Migration Units
INVENTORY_TARGET_STATUS=migrated

# -----------------------------------------------------------------------------
# 4. Jenkins CI Credentials (Optional: required if using JenkinsJobPreCheck or JenkinsTriggerPostCheck)
# -----------------------------------------------------------------------------
JENKINS_URL=
JENKINS_USERNAME=
JENKINS_TOKEN=

# -----------------------------------------------------------------------------
# 5. Execution & Logging Tuning (Optional)
# -----------------------------------------------------------------------------
# Maximum concurrent worker threads for parallel per-unit stages
MAX_WORKERS=4
# Polling interval (seconds) when waiting for CI completion in Post-checks
CI_POLL_INTERVAL_SECONDS=5.0
# Maximum wait time (seconds) when polling CI in Post-checks
CI_POLL_TIMEOUT_SECONDS=300.0
# Python logging level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO
